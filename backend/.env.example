# Hugging Face / Qwen configuration
HF_TOKEN=your_hugging_face_token_here
HF_MODEL=Qwen/Qwen3-8B
HF_PROVIDER=nscale

# ElevenLabs voice service (optional — STT for interview answers)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Serper web search (optional — dynamic free course recommendations for skill gaps)
SERPER_API_KEY=your_serper_api_key_here

# PostgreSQL — use Supabase connection string or local Postgres
# Supabase: Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Or individual fields (used when DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=career_iq
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT secret — change in production
JWT_SECRET=your_random_secret_here

# Admin login (created on server start if missing)
ADMIN_EMAIL=admin@careeriq.local
ADMIN_PASSWORD=change-this-admin-password

# Server port (default: 5000)
PORT=5000

# Interview identity (optional — defaults in services/identity.js)
# IDENTITY_MATCH_THRESHOLD=0.88
# IDENTITY_LIVENESS_MIN_DELTA=0.035
