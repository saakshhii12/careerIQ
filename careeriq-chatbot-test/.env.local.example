# ------------------------------------------------------------------
# Copy this file to `.env.local` (Next.js loads it automatically)
# and fill in your real Groq API key.
#
# IMPORTANT: Never prefix these with NEXT_PUBLIC_ — that would ship
# the value to the browser bundle. This key is only ever read inside
# src/app/api/chat/route.ts and
# src/features/chatbot/services/groqServer.ts, both of which run
# exclusively on the server.
# ------------------------------------------------------------------

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional — override the model without touching any code.
# Default lives in src/features/chatbot/utils/chatConfig.ts
GROQ_MODEL=your_model_name_here
